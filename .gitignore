node_modules/
out/
build/
dist/
artifacts/
.venv-import/
.DS_Store
__pycache__/
*.py[cod]

# Reference/test/example decks live under decks/. Only what the tests and
# the agent CLI need is tracked: demo-deck, reference, agent-reference,
# test-presentation geometry, and animation-reference's deck files. Everything
# else — imported corpora, large media, generated renders — stays local.
decks/imported-*/
decks/exported-*/
decks/animation-reference/assets/
decks/*/edit/.workflow*
test_presentation.key
decks/test-presentation/assets/

# Large local presentation corpus used by the importer regression suite.
example_presentations/

# Collab server data: decks people edit live, including large media.
collab-decks/

# Local reference presentation (>100MB, stripped from history).
reference.key
