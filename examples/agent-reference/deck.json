    {
      "id": "text-roles",
      "name": "Text styled by theme class, never by inline font sizes.",
      "background": {
        "color": null,
        "image": null
      },
      "notes": "Text styled by theme class, never by inline font sizes.\n\nWhen: Every piece of text. Pick the role; let theme.css size it.\n- role-title, role-heading, role-body, role-caption are the vocabulary.\n- An inline `style` overrides the theme and should be a deliberate one-off.\n- html may contain inline markup: <b>, <i>, <br>, <span>.",
      "elements": [
        {
          "id": "cap-roles-title",
          "x": 160,
          "y": 90,
          "w": 1600,
          "h": 150,
          "rot": 0,
          "z": 1,
          "opacity": 1,
          "class": [
            "role-title"
          ],
          "style": {},
          "type": "text",
          "html": "A title in the deck’s own type",
          "align": "left",
          "valign": "top"
        },
        {
          "id": "cap-roles-body",
          "x": 160,
          "y": 300,
          "w": 1600,
          "h": 200,
          "rot": 0,
          "z": 1,
          "opacity": 1,
          "class": [
            "role-body"
          ],
          "style": {},
          "type": "text",
          "html": "Body text carries <b>bold</b> and <i>italic</i> inline.",
          "align": "left",
          "valign": "top"
        },
        {
          "id": "cap-roles-caption",
