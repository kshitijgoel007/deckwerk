    {
      "id": "latex",
      "name": "LaTeX maths, rendered by KaTeX at present time.",
      "background": {
        "color": null,
        "image": null
      },
      "notes": "LaTeX maths, rendered by KaTeX at present time.\n\nWhen: Any equation. Never hand-build maths out of positioned text.\n- $…$ is inline and stays in the sentence flow; $$…$$ is display.\n- A literal dollar sign is written \\$.\n- The equation is part of the text element’s html — not a separate element.",
      "elements": [
        {
          "id": "cap-latex-title",
          "x": 160,
          "y": 90,
          "w": 1600,
          "h": 150,
          "rot": 0,
          "z": 1,
          "opacity": 1,
          "class": [
            "role-title"
          ],
          "style": {},
          "type": "text",
          "html": "Maths is text, not layout",
          "align": "left",
          "valign": "top"
        },
        {
          "id": "cap-latex-inline",
          "x": 160,
          "y": 320,
          "w": 1600,
          "h": 120,
          "rot": 0,
          "z": 1,
          "opacity": 1,
          "class": [
            "role-body"
          ],
          "style": {},
          "type": "text",
          "html": "A rendering is a function $f_\\theta(\\mathbf{x}) \\rightarrow (\\mathbf{c}, \\sigma)$ of position.",
          "align": "left",
          "valign": "top"
        },
        {
          "id": "cap-latex-display",
          "x": 160,
          "y": 470,
          "w": 1600,
          "h": 300,
          "rot": 0,
          "z": 1,
          "opacity": 1,
          "class": [
            "role-body"
          ],
          "style": {},
          "type": "text",
          "html": "Volume rendering integrates along the ray: $$C(\\mathbf{r}) = \\int_{t_n}^{t_f} T(t)\\,\\sigma(\\mathbf{r}(t))\\,\\mathbf{c}(t)\\,dt$$",
          "align": "left",
          "valign": "top"
        }
      ],
      "timeline": []
    },
